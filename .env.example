# ==========================================
# Battleora Environment Variables (Supabase PostgreSQL)
# ==========================================

# Vercel Environment Variables:
# DATABASE_URL (Transaction Pooler - Port 6543):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# DIRECT_URL (Session Pooler - Port 5432):
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# ==========================================
# AI Assistant API Keys (Add any one to Vercel)
# ==========================================
# Google Gemini (Free at aistudio.google.com):
# GEMINI_API_KEY="your-gemini-api-key"
# AI_GEMINI_MODEL="gemini-flash-latest"

# Or Groq (Free fast inference at console.groq.com):
# GROQ_API_KEY="gsk_..."
# AI_GROQ_MODEL="llama-3.3-70b-versatile"

# Or OpenAI:
# OPENAI_API_KEY="sk-..."
# AI_OPENAI_MODEL="gpt-4o-mini"
